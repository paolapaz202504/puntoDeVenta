# ==========================================
# puntoV - Frontend (.gitignore)
# React / Vite / TypeScript / Tailwind CSS
# ==========================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Compilación y artefactos de producción
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo

# Variables de entorno y secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Logs y depuración
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura y reportes de pruebas (Vitest / Playwright)
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs y editores
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporales de Vite y herramientas de desarrollo
.vite/
*.tmp
*.temp
.cache/
